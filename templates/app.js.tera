<script type="module">
// ── Driver → language mapping (injected at build time) ─────────────────────
const DRIVER_LANGUAGES = {{ driver_languages_json | safe }};

// ── Cross-chart brush state ──────────────────────────────────────────────────
// Both fields are Sets so any number of items can be co-highlighted.
let brushState = { drivers: new Set(), languages: new Set() };

/**
 * Highlight a collection of drivers (and optionally specific language bars).
 * When `explicitLanguages` is omitted the languages are derived automatically
 * from DRIVER_LANGUAGES so clicking/hovering any driver always lights up its
 * language bar too.
 */
function applyBrush(driverNames, explicitLanguages = null) {
  const driverSet = new Set(driverNames);
  const languageSet = explicitLanguages
    ? new Set(explicitLanguages)
    : new Set(driverNames.map(d => DRIVER_LANGUAGES[d]).filter(Boolean));

  // Bail early if the selection is identical to the current state
  if (driverSet.size === brushState.drivers.size &&
      languageSet.size === brushState.languages.size &&
      [...driverSet].every(d => brushState.drivers.has(d)) &&
      [...languageSet].every(l => brushState.languages.has(l))) return;

  brushState = { drivers: driverSet, languages: languageSet };

  document.querySelectorAll('.charts-grid svg').forEach(svg => {
    svg.classList.add('brush-active');
    svg.querySelectorAll('.chart-row').forEach(el => el.classList.remove('brushed'));

    // Single-driver bar / box-plot rows
    svg.querySelectorAll('[data-driver]').forEach(el => {
      if (driverSet.has(el.getAttribute('data-driver'))) el.classList.add('brushed');
    });

    // Multi-driver timeline circles: brushed if ANY of their drivers is selected
    svg.querySelectorAll('[data-drivers]').forEach(el => {
      const elDrivers = el.getAttribute('data-drivers').split(',');
      if (elDrivers.some(d => driverSet.has(d))) el.classList.add('brushed');
    });

    // Language bars
    svg.querySelectorAll('[data-language]').forEach(el => {
      if (languageSet.has(el.getAttribute('data-language'))) el.classList.add('brushed');
    });
  });
}

function clearBrush() {
  brushState = { drivers: new Set(), languages: new Set() };
  document.querySelectorAll('.charts-grid svg').forEach(svg => {
    svg.classList.remove('brush-active');
    svg.querySelectorAll('.chart-row').forEach(el => el.classList.remove('brushed'));
  });
}

function setupBrushHandlers() {
  const chartsGrid = document.querySelector('.charts-grid');
  if (!chartsGrid) return;

  chartsGrid.addEventListener('mouseover', event => {
    const row = event.target.closest('.chart-row');
    const inSvg = event.target.closest('svg');

    if (row) {
      const driver   = row.getAttribute('data-driver');   // single driver (bar/box)
      const drivers  = row.getAttribute('data-drivers');  // multi-driver (timeline date)
      const language = row.getAttribute('data-language'); // language bar

      if (driver) {
        // Skip redundant updates when moving between child elements of the same row
        if (brushState.drivers.size === 1 && brushState.drivers.has(driver)) return;
        applyBrush([driver]);
      } else if (drivers) {
        const arr = drivers.split(',');
        if (brushState.drivers.size === arr.length && arr.every(d => brushState.drivers.has(d))) return;
        applyBrush(arr);
      } else if (language) {
        if (brushState.languages.size === 1 && brushState.languages.has(language)) return;
        const driversWithLang = Object.entries(DRIVER_LANGUAGES)
          .filter(([, lang]) => lang === language)
          .map(([d]) => d);
        applyBrush(driversWithLang, [language]);
      }
    } else if (inSvg) {
      // Hovering SVG whitespace (axis area, etc.) — clear
      clearBrush();
    }
    // Hovering a chart title or other non-SVG element: leave brush as-is
  });

  // Leaving the grid entirely always clears
  chartsGrid.addEventListener('mouseleave', clearBrush);
}

// Expose for any inline onclick handlers that may exist

let db;
let loadingSteps = {};
let tableFilters = {
  drivers: {},
  releases: {},
  libraries: {},
  symbols: {},
  dependencies: {}
};

// Multi-value (OR) filters per column: col → Set<value>
let tableMultiFilters = {
  drivers: {},
  releases: {},
  libraries: {},
  symbols: {},
  dependencies: {}
};

// Track which column's facet panel is currently open for each table
let currentFacetColumns = {
  drivers: null,
  releases: null,
  libraries: null,
  symbols: null,
  dependencies: null,
};

// Track which tables have had their quick-filter widgets initialised
const quickFiltersInitialized = new Set();

// Quick-filter config.
// type 'toggle' – single boolean/value toggle (on/off)
// type 'multi'  – multiselect dropdown
//   colType 'scalar' – plain scalar column  → col IN (a,b) / col = a
//   colType 'list'   – List<T> parquet col  → list_contains(col,a) OR ...
//   options (optional) – static [{label,val}]; omit to load distinct values from DuckDB
const QUICK_FILTERS = {
  drivers: [
    { type: 'multi',  label: 'Language', col: 'language', colType: 'scalar' },
  ],
  releases: [
    { type: 'toggle', label: 'Latest',          col: 'is_latest',            val: true },
    { type: 'toggle', label: 'Universal Binary', col: 'has_universal_binary', val: true },
    { type: 'multi',  label: 'Platform', col: 'os',   colType: 'list' },
    { type: 'multi',  label: 'Arch',     col: 'arch', colType: 'list' },
  ],
  libraries: [
    { type: 'toggle', label: 'Latest',   col: 'is_latest', val: true },
    { type: 'multi',  label: 'Platform', col: 'os',        colType: 'scalar' },
    { type: 'multi',  label: 'Arch',     col: 'arch',      colType: 'list'   },
    { type: 'multi',  label: 'Language', col: 'language',  colType: 'scalar' },
  ],
  symbols: [
    { type: 'toggle', label: 'Latest',   col: 'is_latest', val: true },
    { type: 'multi',  label: 'Platform', col: 'os',        colType: 'scalar' },
    { type: 'multi',  label: 'Arch',     col: 'arch',      colType: 'list'   },
    { type: 'multi',  label: 'Stub',     col: 'is_stub',   colType: 'scalar',
      options: [{ label: 'Stubs', val: true }, { label: 'Non-Stubs', val: false }] },
  ],
  dependencies: [
    { type: 'toggle', label: 'Latest',     col: 'is_latest',  val: true },
    { type: 'multi',  label: 'Platform',   col: 'os',         colType: 'scalar' },
    { type: 'multi',  label: 'Arch',       col: 'arch',       colType: 'list'   },
    { type: 'multi',  label: 'System Dep', col: 'is_system',  colType: 'scalar',
      options: [{ label: 'System', val: true }, { label: 'Non-System', val: false }] },
  ],
};

function updateLoadingStep(id, status, message) {
  if (!loadingSteps[id]) {
    const stepDiv = document.createElement('div');
    stepDiv.id = `step-${id}`;
    stepDiv.className = 'loading-step';
    document.getElementById('loadingSteps').appendChild(stepDiv);
    loadingSteps[id] = stepDiv;
  }

  const stepDiv = loadingSteps[id];
  stepDiv.className = `loading-step ${status}`;

  const icon = status === 'active' ? '⏳' : status === 'success' ? '✓' : status === 'error' ? '✗' : '';
  stepDiv.textContent = `${icon} ${message}`;
}

function setTableStatus(tableId, status, message) {
  const statusEl = document.getElementById(`${tableId}Status`);
  if (statusEl) {
    statusEl.className = `status-indicator ${status}`;
    const icon = status === 'loading' ? '⏳' : status === 'success' ? '✓' : status === 'error' ? '✗' : '';
    statusEl.textContent = message ? `${icon} ${message}` : icon;
  }
}

function showQueryError(tableId, errorMessage) {
  const errorEl = document.getElementById(`${tableId}Error`);
  if (errorEl) {
    errorEl.innerHTML = `<strong>Query Error:</strong> ${errorMessage}`;
    errorEl.classList.add('visible');
  }
}

function hideQueryError(tableId) {
  const errorEl = document.getElementById(`${tableId}Error`);
  if (errorEl) {
    errorEl.classList.remove('visible');
    errorEl.innerHTML = '';
  }
}

function showError(title, message, details) {
  const errorDiv = document.createElement('div');
  errorDiv.className = 'error-details';
  errorDiv.innerHTML = `
    <h3>${title}</h3>
    <p>${message}</p>
    ${details ? `<pre>${details}</pre>` : ''}
  `;
  document.querySelector('.loading-content').appendChild(errorDiv);
}

async function initDuckDB() {
  updateLoadingStep('import', 'active', 'Loading DuckDB WASM module...');

  let duckdb;
  try {
    duckdb = await import('https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.32.0/+esm');
    updateLoadingStep('import', 'success', 'DuckDB WASM module loaded');
  } catch (err) {
    updateLoadingStep('import', 'error', 'Failed to load DuckDB WASM module');
    throw new Error(`Failed to import DuckDB WASM: ${err.message}`);
  }

  updateLoadingStep('init', 'active', 'Initializing DuckDB...');

  try {
    const JSDELIVR_BUNDLES = duckdb.getJsDelivrBundles();
    const bundle = await duckdb.selectBundle(JSDELIVR_BUNDLES);

    const worker_url = URL.createObjectURL(
      new Blob([`importScripts("${bundle.mainWorker}");`], {type: "text/javascript"})
    );

    const worker = new Worker(worker_url);
    const logger = new duckdb.ConsoleLogger();
    db = new duckdb.AsyncDuckDB(logger, worker);
    await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
    URL.revokeObjectURL(worker_url);

    updateLoadingStep('init', 'success', 'DuckDB initialized');
  } catch (err) {
    updateLoadingStep('init', 'error', 'Failed to initialize DuckDB');
    throw new Error(`Failed to initialize DuckDB: ${err.message}`);
  }

  // Register parquet files in DuckDB's file system
  const files = [
    { name: 'drivers.parquet', id: 'drivers' },
    { name: 'releases.parquet', id: 'releases' },
    { name: 'libraries.parquet', id: 'libraries' },
    { name: 'symbols.parquet', id: 'symbols' },
    { name: 'dependencies.parquet', id: 'dependencies' }
  ];

  for (const file of files) {
    updateLoadingStep(`fetch-${file.name}`, 'active', `Fetching ${file.name}...`);
    try {
      const response = await fetch(file.name);
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      const buffer = await response.arrayBuffer();
      const sizeKB = (buffer.byteLength / 1024).toFixed(1);
      await db.registerFileBuffer(file.name, new Uint8Array(buffer));
      updateLoadingStep(`fetch-${file.name}`, 'success', `${file.name} loaded (${sizeKB} KB)`);

      // Update download link with file size
      const sizeEl = document.getElementById(`size-${file.id}`);
      if (sizeEl) {
        sizeEl.textContent = `${sizeKB} KB`;
      }
    } catch (err) {
      updateLoadingStep(`fetch-${file.name}`, 'error', `Failed to load ${file.name}`);

      // Update download link with error
      const sizeEl = document.getElementById(`size-${file.id}`);
      if (sizeEl) {
        sizeEl.textContent = 'Error loading';
        sizeEl.style.color = '#dc3545';
      }

      throw new Error(`Failed to fetch ${file.name}: ${err.message}`);
    }
  }
}

function convertBigIntsToNumbers(obj) {
  const result = {};
  for (const [key, value] of Object.entries(obj)) {
    if (typeof value === 'bigint') {
      // Convert BigInt to Number for JavaScript compatibility
      result[key] = Number(value);
    } else {
      result[key] = value;
    }
  }
  return result;
}

// Build a type-aware SQL WHERE condition (handles booleans, numbers, nulls, strings)
function buildSqlCondition(col, val) {
  if (val === null || val === undefined) {
    return `${col} IS NULL`;
  } else if (typeof val === 'boolean') {
    return `${col} = ${val}`;
  } else if (typeof val === 'number') {
    return `${col} = ${val}`;
  } else {
    const escaped = String(val).replace(/'/g, "''");
    return `${col} = '${escaped}'`;
  }
}

function filterTableByCell(tableName, columnName, value) {
  const filters = tableFilters[tableName];

  // Toggle single-value filter for this column
  const hasFilter = Object.prototype.hasOwnProperty.call(filters, columnName);
  const isSameValue = hasFilter && (
    (filters[columnName] === value) ||
    (filters[columnName] === null && value === null)
  );

  if (isSameValue) {
    delete filters[columnName];
  } else {
    filters[columnName] = value;
    // Single and multi-value filters are mutually exclusive per column
    delete tableMultiFilters[tableName][columnName];
  }

  // Rebuild SQL textarea and refresh UI
  rebuildQuery(tableName);
  updateQuickFilterStates(tableName);
  renderActiveFilters(tableName);

  // Run the query
  const runFunctions = {
    'drivers': runDriversQuery,
    'releases': runReleasesQuery,
    'libraries': runLibrariesQuery,
    'symbols': runSymbolsQuery,
    'dependencies': runDependenciesQuery
  };

  const runFunction = runFunctions[tableName];
  if (runFunction) {
    console.log('Running query...');
    // Pass skipClearFilters = true to prevent clearing the filters we just set
    runFunction(true);
  } else {
    console.error(`No run function found for table: ${tableName}`);
  }
}

// ── Filter UI helpers ──────────────────────────────────────────────────────

// One-time creation of all quick-filter widgets for a table.
function initQuickFilters(tableName) {
  const container = document.getElementById(tableName + 'QuickFilters');
  if (!container) return;
  const presets = QUICK_FILTERS[tableName] || [];
  container.innerHTML = '';
  if (presets.length === 0) return;

  const label = document.createElement('span');
  label.className = 'quick-filters-label';
  label.textContent = 'Quick:';
  container.appendChild(label);

  presets.forEach(preset => {
    if (preset.type === 'toggle') {
      const btn = document.createElement('button');
      btn.className = 'quick-filter-btn toggle-filter-btn';
      btn.dataset.col = preset.col;
      btn.dataset.val = JSON.stringify(preset.val);
      btn.textContent = preset.label;
      btn.title = buildSqlCondition(preset.col, preset.val);
      btn.onclick = () => filterTableByCell(tableName, preset.col, preset.val);
      container.appendChild(btn);
    } else if (preset.type === 'multi') {
      renderMultiSelectFilter(tableName, preset, container);
    }
  });

  updateQuickFilterStates(tableName);
}

// Lightweight state update – only touches CSS classes and count badges;
// never recreates DOM so open dropdowns stay open.
function updateQuickFilterStates(tableName) {
  const container = document.getElementById(tableName + 'QuickFilters');
  if (!container) return;

  // Toggle buttons
  container.querySelectorAll('.toggle-filter-btn').forEach(btn => {
    const col = btn.dataset.col;
    const val = JSON.parse(btn.dataset.val);
    const isActive = Object.prototype.hasOwnProperty.call(tableFilters[tableName], col) &&
      tableFilters[tableName][col] === val;
    btn.classList.toggle('active', isActive);
  });

  // Multiselect buttons
  (QUICK_FILTERS[tableName] || []).filter(p => p.type === 'multi').forEach(preset => {
    const wrapper = document.getElementById(`${tableName}-multi-${preset.col}`);
    if (!wrapper) return;
    const vals = tableMultiFilters[tableName][preset.col];
    const count = vals ? vals.size : 0;
    wrapper.querySelector('.multi-filter-btn')?.classList.toggle('active', count > 0);
    const badge = wrapper.querySelector('.multi-filter-count');
    if (badge) { badge.textContent = count; badge.classList.toggle('hidden', count === 0); }
  });
}

function createFilterChip(text, onRemove) {
  const chip = document.createElement('span');
  chip.className = 'filter-chip';
  const lbl = document.createElement('span');
  lbl.textContent = text;
  chip.appendChild(lbl);
  const x = document.createElement('button');
  x.className = 'filter-chip-remove';
  x.textContent = '\u00d7';
  x.title = 'Remove filter';
  x.onclick = onRemove;
  chip.appendChild(x);
  return chip;
}

function renderActiveFilters(tableName) {
  const container = document.getElementById(tableName + 'ActiveFilters');
  if (!container) return;
  container.innerHTML = '';

  // Single-value filter chips
  Object.entries(tableFilters[tableName]).forEach(([col, val]) => {
    container.appendChild(createFilterChip(
      `${col}: ${val === null ? 'NULL' : String(val)}`,
      () => filterTableByCell(tableName, col, val)
    ));
  });

  // Multi-value filter chips
  Object.entries(tableMultiFilters[tableName]).forEach(([col, vals]) => {
    if (!vals || vals.size === 0) return;
    const preset = (QUICK_FILTERS[tableName] || []).find(p => p.type === 'multi' && p.col === col);
    const valStrs = [...vals].map(v => {
      const opt = preset?.options?.find(o => String(o.val) === String(v));
      return opt ? opt.label : String(v);
    });
    container.appendChild(createFilterChip(
      `${col}: ${valStrs.join(', ')}`,
      () => clearMultiFilter(tableName, col)
    ));
  });
}

async function showColumnFacet(tableName, colId) {
  const panel    = document.getElementById(tableName + 'ColumnFacet');
  const nameEl   = document.getElementById(tableName + 'FacetColName');
  const valuesEl = document.getElementById(tableName + 'FacetValues');
  if (!panel || !nameEl || !valuesEl) return;

  currentFacetColumns[tableName] = colId;
  panel.classList.remove('hidden');
  nameEl.textContent = colId;
  valuesEl.innerHTML = '<span class="facet-loading">Loading…</span>';

  try {
    const sql = `SELECT ${colId} AS val, COUNT(*) AS cnt FROM read_parquet('${tableName}.parquet') GROUP BY ${colId} ORDER BY cnt DESC LIMIT 50`;
    const data = await queryDuckDB(sql, `facet-${tableName}-${colId}`);
    valuesEl.innerHTML = '';
    if (data.length === 0) {
      valuesEl.innerHTML = '<span class="facet-loading">No values found</span>';
      return;
    }
    data.forEach(row => {
      const pill = document.createElement('button');
      pill.className = 'facet-value-pill';
      const rowVal = row.val;
      // Store raw string for active-state re-checks after re-render
      pill.dataset.rawVal = rowVal === null ? '__null__' : String(rowVal);
      const isActive = Object.prototype.hasOwnProperty.call(tableFilters[tableName], colId) &&
        String(tableFilters[tableName][colId]) === String(rowVal);
      if (isActive) pill.classList.add('active');
      const displayVal = rowVal === null ? 'NULL' : String(rowVal);
      pill.textContent = `${displayVal} (${row.cnt})`;
      pill.title = buildSqlCondition(colId, rowVal);
      pill.onclick = () => filterTableByCell(tableName, colId, rowVal);
      valuesEl.appendChild(pill);
    });
  } catch (err) {
    valuesEl.innerHTML = `<span style="color:var(--error);font-size:11px">Cannot facet this column: ${err.message}</span>`;
  }
}

function closeColumnFacet(tableName) {
  const panel = document.getElementById(tableName + 'ColumnFacet');
  if (panel) panel.classList.add('hidden');
  currentFacetColumns[tableName] = null;
}

// ── Multi-filter system ──────────────────────────────────────────────────────

function buildMultiCondition(col, values, colType, totalOptions) {
  const vals = [...values];
  if (vals.length === 0) return null;
  // No condition needed when all options of a fixed set are selected
  if (totalOptions != null && vals.length >= totalOptions) return null;

  if (colType === 'list') {
    const parts = vals.map(v => `list_contains(${col}, '${String(v).replace(/'/g, "''")}')`);
    return parts.length === 1 ? parts[0] : `(${parts.join(' OR ')})`;
  } else {
    if (vals.length === 1) return buildSqlCondition(col, vals[0]);
    const inList = vals.map(v =>
      typeof v === 'boolean' || typeof v === 'number' ? String(v) : `'${String(v).replace(/'/g, "''")}'`
    ).join(', ');
    return `${col} IN (${inList})`;
  }
}

function buildAllWhereClauses(tableName) {
  const clauses = [];
  for (const [col, val] of Object.entries(tableFilters[tableName]))
    clauses.push(buildSqlCondition(col, val));
  for (const [col, vals] of Object.entries(tableMultiFilters[tableName])) {
    if (!vals || vals.size === 0) continue;
    const preset = (QUICK_FILTERS[tableName] || []).find(p => p.type === 'multi' && p.col === col);
    const cond = buildMultiCondition(col, vals, preset?.colType || 'scalar', preset?.options?.length ?? null);
    if (cond) clauses.push(cond);
  }
  return clauses;
}

function rebuildQuery(tableName) {
  const el = document.getElementById(tableName + 'Query');
  if (!el) return;
  const clauses = buildAllWhereClauses(tableName);
  el.value = clauses.length === 0
    ? `SELECT * FROM read_parquet('${tableName}.parquet')`
    : `SELECT * FROM read_parquet('${tableName}.parquet') WHERE ${clauses.join(' AND ')}`;
}

function rebuildAndRun(tableName) {
  rebuildQuery(tableName);
  updateQuickFilterStates(tableName);
  renderActiveFilters(tableName);
  ({ drivers: runDriversQuery, releases: runReleasesQuery, libraries: runLibrariesQuery,
     symbols: runSymbolsQuery, dependencies: runDependenciesQuery })[tableName]?.(true);
}

function closeAllDropdowns() {
  document.querySelectorAll('.multi-filter-dropdown:not(.hidden)')
    .forEach(d => d.classList.add('hidden'));
}

function renderMultiSelectFilter(tableName, preset, container) {
  const wrapper = document.createElement('div');
  wrapper.className = 'multi-filter-wrapper';
  wrapper.id = `${tableName}-multi-${preset.col}`;

  const btn = document.createElement('button');
  btn.className = 'quick-filter-btn multi-filter-btn';

  const btnText  = document.createElement('span'); btnText.textContent = preset.label;
  const badge    = document.createElement('span'); badge.className = 'multi-filter-count hidden';
  const arrow    = document.createElement('span'); arrow.className  = 'multi-filter-arrow'; arrow.textContent = ' ▾';
  btn.append(btnText, badge, arrow);

  const dropdown = document.createElement('div');
  dropdown.className = 'multi-filter-dropdown hidden';

  const optionsDiv = document.createElement('div');
  optionsDiv.className = 'multi-filter-options';
  optionsDiv.innerHTML = '<div class="facet-loading" style="padding:8px 12px">Loading…</div>';

  const footer  = document.createElement('div');   footer.className  = 'multi-filter-footer';
  const clearBtn = document.createElement('button'); clearBtn.className = 'multi-filter-clear-btn';
  clearBtn.textContent = 'Clear';
  clearBtn.onclick = e => { e.stopPropagation(); clearMultiFilter(tableName, preset.col); };
  footer.appendChild(clearBtn);

  dropdown.append(optionsDiv, footer);
  // Prevent clicks inside dropdown from bubbling to the global close handler
  dropdown.addEventListener('click', e => e.stopPropagation());

  let loaded = false;
  btn.onclick = async e => {
    e.stopPropagation();
    const wasOpen = !dropdown.classList.contains('hidden');
    closeAllDropdowns();
    if (!wasOpen) {
      dropdown.classList.remove('hidden');
      // Always reload dynamic options; static options only once
      if (!loaded || !preset.options) {
        loaded = true;
        await loadMultiFilterOptions(tableName, preset, optionsDiv);
      }
    }
  };

  wrapper.append(btn, dropdown);
  container.appendChild(wrapper);
}

async function loadMultiFilterOptions(tableName, preset, optionsDiv) {
  let rows;
  if (preset.options) {
    // Static options (e.g. boolean columns)
    rows = preset.options.map(o => ({ val: o.val, label: o.label, count: undefined }));
  } else {
    try {
      let sql;
      if (preset.colType === 'list') {
        sql = `SELECT _v AS val, COUNT(*) AS cnt FROM read_parquet('${tableName}.parquet'), UNNEST(${preset.col}) AS _t(_v) WHERE _v IS NOT NULL GROUP BY val ORDER BY cnt DESC LIMIT 50`;
      } else {
        sql = `SELECT ${preset.col} AS val, COUNT(*) AS cnt FROM read_parquet('${tableName}.parquet') WHERE ${preset.col} IS NOT NULL GROUP BY val ORDER BY cnt DESC LIMIT 50`;
      }
      const data = await queryDuckDB(sql, `multi-opts-${tableName}-${preset.col}`);
      rows = data.map(r => ({ val: r.val, label: String(r.val), count: r.cnt }));
    } catch (err) {
      optionsDiv.innerHTML = `<div style="padding:8px 12px;color:var(--error);font-size:11px">Error: ${err.message}</div>`;
      return;
    }
  }

  optionsDiv.innerHTML = '';
  const selected = tableMultiFilters[tableName][preset.col] || new Set();

  rows.forEach(row => {
    const div = document.createElement('div');
    div.className = 'multi-filter-option';

    const cb = document.createElement('input'); cb.type = 'checkbox';
    cb.checked = [...selected].some(v => String(v) === String(row.val));
    cb.onclick = e => e.stopPropagation();

    const lbl = document.createElement('span'); lbl.className = 'multi-filter-option-label';
    lbl.textContent = row.label;

    div.append(cb, lbl);

    if (row.count !== undefined) {
      const cnt = document.createElement('span'); cnt.className = 'multi-filter-option-count';
      cnt.textContent = row.count;
      div.appendChild(cnt);
    }

    div.onclick = e => {
      e.stopPropagation();
      cb.checked = !cb.checked;
      toggleMultiFilterValue(tableName, preset, row.val, cb.checked);
    };

    optionsDiv.appendChild(div);
  });
}

function toggleMultiFilterValue(tableName, preset, val, checked) {
  if (!tableMultiFilters[tableName][preset.col]) tableMultiFilters[tableName][preset.col] = new Set();
  const set = tableMultiFilters[tableName][preset.col];
  if (checked) {
    set.add(val);
    delete tableFilters[tableName][preset.col]; // mutually exclusive with single filter
  } else {
    for (const v of set) { if (String(v) === String(val)) { set.delete(v); break; } }
  }
  rebuildAndRun(tableName);
}

function clearMultiFilter(tableName, col) {
  delete tableMultiFilters[tableName][col];
  rebuildAndRun(tableName);
}

async function queryDuckDB(sql, context) {
  let conn;
  try {
    conn = await db.connect();
    const result = await conn.query(sql);
    const data = result.toArray().map(row => convertBigIntsToNumbers(Object.fromEntries(Object.entries(row))));
    return data;
  } catch (err) {
    console.error(`Query failed [${context}]:`, err);
    throw new Error(`Query failed: ${err.message}`);
  } finally {
    if (conn) {
      try {
        await conn.close();
      } catch (e) {
        console.warn('Failed to close connection:', e);
      }
    }
  }
}

let driversGrid = null;

async function loadDriversTable(customSQL) {
  console.log('loadDriversTable called with customSQL:', customSQL);
  setTableStatus('drivers', 'loading', 'Loading...');
  hideQueryError('drivers');

  try {
    const sql = customSQL || document.getElementById('driversQuery').value;
    console.log('Executing SQL:', sql);
    const data = await queryDuckDB(sql, 'drivers');
    console.log('Query returned', data?.length, 'rows');

    if (!data || data.length === 0) {
      setTableStatus('drivers', 'error', 'No data');
      showQueryError('drivers', 'Query returned no results');
      if (driversGrid) {
        driversGrid.destroy();
        driversGrid = null;
      }
      return;
    }

    // Dynamically create column definitions from the data
    const columnDefs = Object.keys(data[0]).map(key => ({
      field: key,
      headerName: key,
      filter: true,
      sortable: true,
      flex: 1,
      minWidth: 100
    }));

    const gridOptions = {
      columnDefs: columnDefs,
      rowData: data,
      defaultColDef: {
        resizable: true,
        sortable: true,
        filter: true
      },
      pagination: true,
      paginationPageSize: 20,
      onCellDoubleClicked: (event) => {
        filterTableByCell('drivers', event.colDef.field, event.value);
      },
      onColumnHeaderClicked: (event) => {
        showColumnFacet('drivers', event.column.getColId());
      }
    };

    // Destroy existing grid before creating new one
    if (driversGrid) {
      driversGrid.destroy();
    }

    driversGrid = agGrid.createGrid(document.getElementById('driversGrid'), gridOptions);

    if (!quickFiltersInitialized.has('drivers')) {
      quickFiltersInitialized.add('drivers');
      initQuickFilters('drivers');
    } else {
      updateQuickFilterStates('drivers');
    }
    renderActiveFilters('drivers');
    if (currentFacetColumns['drivers']) showColumnFacet('drivers', currentFacetColumns['drivers']);
    setTableStatus('drivers', 'success', `${data.length} rows`);
  } catch (err) {
    console.error('Failed to load drivers table:', err);
    setTableStatus('drivers', 'error', err.message);
    showQueryError('drivers', err.message);
    if (driversGrid) {
      driversGrid.destroy();
      driversGrid = null;
    }
  }
}

async function runDriversQuery(skipClearFilters = false) {
  console.log('Running drivers query...');
  const queryText = document.getElementById('driversQuery').value;
  console.log('Query:', queryText);

  // Clear filters when running a manual query (but not when called from filterTableByCell)
  if (!skipClearFilters) {
    tableFilters.drivers = {};
    tableMultiFilters.drivers = {};
    closeAllDropdowns();
    closeColumnFacet('drivers');
  }

  await loadDriversTable();
  updateURL();
}

let releasesGrid = null;

async function loadReleasesTable(customSQL) {
  setTableStatus('releases', 'loading', 'Loading...');
  hideQueryError('releases');

  try {
    const sql = customSQL || document.getElementById('releasesQuery').value;
    const data = await queryDuckDB(sql, 'releases');

    if (!data || data.length === 0) {
      setTableStatus('releases', 'error', 'No data');
      showQueryError('releases', 'Query returned no results');
      if (releasesGrid) {
        releasesGrid.destroy();
        releasesGrid = null;
      }
      return;
    }

    // Dynamically create column definitions from the data
    const columnDefs = Object.keys(data[0]).map(key => ({
      field: key,
      headerName: key,
      filter: true,
      sortable: true,
      flex: 1,
      minWidth: 100,
      cellRenderer: (params) => {
        // Handle null/undefined values
        if (params.value === null || params.value === undefined) {
          return '';
        }
        // Auto-link URL fields
        if (key.includes('url') && typeof params.value === 'string' && params.value.startsWith('http')) {
          const link = document.createElement('a');
          link.href = params.value;
          link.target = '_blank';
          link.textContent = params.value;
          return link;
        }
        // Format array fields
        if (Array.isArray(params.value)) {
          return params.value.join(', ');
        }
        return String(params.value);
      }
    }));

    const gridOptions = {
      columnDefs: columnDefs,
      rowData: data,
      defaultColDef: {
        resizable: true,
        sortable: true,
        filter: true
      },
      pagination: true,
      paginationPageSize: 50,
      onCellDoubleClicked: (event) => {
        filterTableByCell('releases', event.colDef.field, event.value);
      },
      onColumnHeaderClicked: (event) => {
        showColumnFacet('releases', event.column.getColId());
      }
    };

    // Destroy existing grid before creating new one
    if (releasesGrid) {
      releasesGrid.destroy();
    }

    releasesGrid = agGrid.createGrid(document.getElementById('releasesGrid'), gridOptions);

    if (!quickFiltersInitialized.has('releases')) {
      quickFiltersInitialized.add('releases');
      initQuickFilters('releases');
    } else {
      updateQuickFilterStates('releases');
    }
    renderActiveFilters('releases');
    if (currentFacetColumns['releases']) showColumnFacet('releases', currentFacetColumns['releases']);
    setTableStatus('releases', 'success', `${data.length} rows`);
  } catch (err) {
    console.error('Failed to load releases table:', err);
    setTableStatus('releases', 'error', err.message);
    showQueryError('releases', err.message);
    if (releasesGrid) {
      releasesGrid.destroy();
      releasesGrid = null;
    }
  }
}

